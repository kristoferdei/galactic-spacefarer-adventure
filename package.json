{
  "name": "galactic-spacefarer",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10.0.5",
    "nodemailer": "^9.0.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-spacefarerapp": "cds watch --open galactic.spacefarer.ui.spacefarerapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "users": {
          "alice": {
            "roles": [
              "admin"
            ],
            "attr": {
              "planet": "Earth"
            }
          },
          "bob": {
            "attr": {
              "planet": "Mars"
            }
          }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/spacefarerapp"
  ]
}
